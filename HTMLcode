  <script>
    /* nav */
    const hd = document.getElementById('hd'), nv = document.getElementById('nv');
    addEventListener('scroll', () => hd.classList.toggle('on', scrollY > 60));
    document.getElementById('bg').onclick = () => nv.classList.toggle('show');
    nv.onclick = e => { if (e.target.tagName === 'A') nv.classList.remove('show'); };

    /* countdown — change this date to your actual event date */
    const target = new Date('2026-03-14T09:00:00+05:30').getTime();
    setInterval(() => {
      let t = target - Date.now(); if (t < 0) t = 0;
      const p = n => String(n).padStart(2, '0');
      document.getElementById('d').textContent = p(Math.floor(t / 864e5));
      document.getElementById('h').textContent = p(Math.floor(t / 36e5) % 24);
      document.getElementById('m').textContent = p(Math.floor(t / 6e4) % 60);
      document.getElementById('s').textContent = p(Math.floor(t / 1e3) % 60);
    }, 1000);

    /* reveal on scroll */
    const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && e.target.classList.add('in')), { threshold: .12 });
    document.querySelectorAll('.rev').forEach(el => io.observe(el));

    /* faq */
    document.querySelectorAll('.faq button').forEach(b => b.onclick = () => {
      const f = b.parentElement, open = f.classList.contains('open');
      document.querySelectorAll('.faq').forEach(x => x.classList.remove('open'));
      if (!open) f.classList.add('open');
    });

    /* form */
    document.getElementById('rf').onsubmit = e => {
      e.preventDefault();
      document.getElementById('ok').style.display = 'block';
      e.target.reset();
    };

    /* starfield */
    const cv = document.getElementById('stars'), cx = cv.getContext('2d');
    let st = [];
    function size() {
      cv.width = innerWidth; cv.height = innerHeight;
      st = Array.from({ length: Math.min(150, Math.floor(innerWidth / 9)) }, () => ({
        x: Math.random() * cv.width, y: Math.random() * cv.height, r: Math.random() * 1.5 + .3,
        v: Math.random() * .3 + .06, o: Math.random() * .7 + .2
      }));
    }
    size(); addEventListener('resize', size);
    (function loop() {
      cx.clearRect(0, 0, cv.width, cv.height);
      st.forEach(p => { p.y -= p.v; if (p.y < 0) { p.y = cv.height; p.x = Math.random() * cv.width; }
        cx.beginPath(); cx.arc(p.x, p.y, p.r, 0, 7); cx.fillStyle = `rgba(180,210,255,${p.o})`; cx.fill(); });
      requestAnimationFrame(loop);
    })();
  </script>
