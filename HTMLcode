  <div class="glow g1"></div><div class="glow g2"></div><div class="glow g3"></div>

  <!-- ====== HEADER ====== -->
  <header id="hd"><div class="wrap nav">
    <a href="#" class="logo">
      <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 340 60'%3E%3Crect width='340' height='60' fill='%2305060f' rx='10'/%3E%3Ctext x='14' y='22' font-family='Syne, sans-serif' font-weight='800' font-size='14' fill='%2300e5ff'%3EGRAPHIC ERA%3C/text%3E%3Ctext x='14' y='38' font-family='Syne, sans-serif' font-weight='500' font-size='10' fill='%23ffffff'%3EHILL UNIV · HALDWANI%3C/text%3E%3Ctext x='14' y='52' font-family='Syne, sans-serif' font-weight='600' font-size='10' fill='%23ffd700'%3EHACKATHON · NIRVAN '26%3C/text%3E%3Ctext x='185' y='24' font-family='Syne, sans-serif' font-weight='800' font-size='20' fill='%237c4dff'%3ETECH%3C/text%3E%3Ctext x='185' y='44' font-family='Syne, sans-serif' font-weight='700' font-size='16' fill='%23ff2d95'%3EGEEKS%3C/text%3E%3C/svg%3E" 
