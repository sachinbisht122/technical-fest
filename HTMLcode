<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NIRVAN '26 · WEB-A-THON 4.0 | Tech Geeks — GEHU Haldwani</title>
  <meta name="description" content="WEB-A-THON 4.0 — Web Design & Development competition under NIRVAN '26 Technical Fest, organised by Tech Geeks Club, Graphic Era Hill University, Haldwani Campus." />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <!-- ====== CSS (separate) ====== -->
  <style>
    /* ----- reset & variables ----- */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #05060f; --bg2: #0b0e1e; --card: rgba(255,255,255,.045);
      --line: rgba(255,255,255,.10);
      --c1: #00e5ff; --c2: #7c4dff; --c3: #ff2d95; --c4: #5cff9d;
      --txt: #eef1ff; --mut: #9aa3c7;
      --grad: linear-gradient(100deg, var(--c1), var(--c2) 55%, var(--c3));
    }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--txt); font-family: 'Space Grotesk', sans-serif; overflow-x: hidden; line-height: 1.65; }
    h1,h2,h3,.logo { font-family: 'Syne', sans-serif; line-height: 1.1; }
    a { color: inherit; text-decoration: none; }
    img { display: block; width: 100%; height: 100%; object-fit: contain; }
    .wrap { width: min(1180px, 92%); margin: auto; }
    .grad { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .mono { font-family: 'JetBrains Mono', monospace; }

    /* ----- background fx ----- */
    #stars { position: fixed; inset: 0; z-index: -2; }
    .glow { position: fixed; border-radius: 50%; filter: blur(120px); opacity: .35; z-index: -1; pointer-events: none; }
    .g1 { width: 520px; height: 520px; background: var(--c2); top: -160px; left: -140px; }
    .g2 { width: 460px; height: 460px; background: var(--c1); top: 40%; right: -180px; opacity: .22; }
    .g3 { width: 420px; height: 420px; background: var(--c3); bottom: -160px; left: 30%; opacity: .18; }
    .grid-bg {
      position: fixed; inset: 0; z-index: -2; opacity: .35;
      background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(circle at 50% 20%, #000 10%, transparent 78%);
    }

    /* ----- nav ----- */
    header { position: fixed; top: 0; left: 0; right: 0; z-index: 99; transition: .35s; padding: 16px 0; }
    header.on { background: rgba(5,6,15,.82); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); padding: 9px 0; }
    .nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .logo { display: flex; align-items: center; gap: 11px; font-size: 1.16rem; letter-spacing: .5px; }
    .logo-img { height: 44px; width: auto; }
    .logo-text { display: flex; flex-direction: column; line-height: 1.1; }
    .logo-text small { font-family: 'JetBrains Mono'; font-size: .6rem; color: var(--mut); letter-spacing: 2.4px; font-weight: 400; }
    nav ul { display: flex; gap: 26px; list-style: none; font-size: .92rem; }
    nav a { color: var(--mut); transition: .25s; position: relative; }
    nav a:hover { color: #fff; }
    nav a::after { content: ''; position: absolute; left: 0; bottom: -6px; width: 0; height: 2px; background: var(--grad); transition: .3s; }
    nav a:hover::after { width: 100%; }
    .btn { display: inline-block; padding: 13px 28px; border-radius: 40px; font-weight: 700; font-size: .92rem; border: 0; cursor: pointer; transition: .3s; font-family: inherit; }
    .btn-p { background: var(--grad); color: #04050e; box-shadow: 0 8px 30px rgba(124,77,255,.4); }
    .btn-p:hover { transform: translateY(-3px); box-shadow: 0 14px 40px rgba(0,229,255,.45); }
    .btn-o { border: 1px solid var(--line); color: #fff; background: rgba(255,255,255,.04); }
    .btn-o:hover { border-color: var(--c1); color: var(--c1); }
    .burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; }
    .burger span { width: 24px; height: 2px; background: #fff; border-radius: 2px; transition: .3s; }

    /* ----- hero ----- */
    .hero { min-height: 100vh; display: flex; align-items: center; padding: 120px 0 70px; position: relative; }
    .hero-badge { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 16px; }
    .hero-badge img { height: 48px; width: auto; }
    .pill { display: inline-flex; align-items: center; gap: 9px; padding: 8px 18px; border: 1px solid var(--line); border-radius: 40px; font-size: .74rem; letter-spacing: 2.6px; color: var(--c1); background: rgba(0,229,255,.07); font-family: 'JetBrains Mono'; }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c4); box-shadow: 0 0 12px var(--c4); animation: blink 1.4s infinite; }
    @keyframes blink { 50% { opacity: .25; } }
    .hero h1 { font-size: clamp(2.9rem, 9vw, 6.6rem); letter-spacing: -2px; margin: 22px 0 6px; }
    .hero h1 span { display: block; }
    .ver { font-family: 'JetBrains Mono'; font-size: clamp(.8rem, 2.4vw, 1.05rem); letter-spacing: 8px; color: var(--mut); margin-bottom: 20px; }
    .hero p.lead { max-width: 600px; color: var(--mut); font-size: 1.04rem; }
    .cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
    .meta { display: flex; gap: 34px; flex-wrap: wrap; margin-top: 46px; padding-top: 26px; border-top: 1px solid var(--line); }
    .meta b { display: block; font-size: 1.28rem; font-family: 'Syne'; }
    .meta small { color: var(--mut); font-size: .72rem; letter-spacing: 2px; font-family: 'JetBrains Mono'; }
    .count { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 38px; }
    .cbox { min-width: 88px; padding: 16px 10px; text-align: center; border: 1px solid var(--line); border-radius: 16px; background: var(--card); backdrop-filter: blur(8px); }
    .cbox b { font-size: 1.9rem; font-family: 'JetBrains Mono'; display: block; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .cbox small { font-size: .6rem; letter-spacing: 2px; color: var(--mut); font-family: 'JetBrains Mono'; }

    /* ----- sections ----- */
    section { padding: 100px 0; position: relative; }
    .head { max-width: 660px; margin-bottom: 52px; }
    .tag { font-family: 'JetBrains Mono'; font-size: .72rem; letter-spacing: 3.4px; color: var(--c3); }
    .head h2 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 12px 0 14px; letter-spacing: -1px; }
    .head p { color: var(--mut); }
    .cards { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(265px, 1fr)); }
    .card { padding: 30px; border: 1px solid var(--line); border-radius: 22px; background: var(--card); backdrop-filter: blur(8px); transition: .35s; position: relative; overflow: hidden; }
    .card:hover { transform: translateY(-8px); border-color: rgba(0,229,255,.45); box-shadow: 0 22px 55px rgba(0,0,0,.5); }
    .card::before { content: ''; position: absolute; inset: 0; background: var(--grad); opacity: 0; transition: .35s; }
    .card:hover::before { opacity: .055; }
    .ico { width: 52px; height: 52px; border-radius: 15px; display: grid; place-items: center; font-size: 1.4rem; background: rgba(255,255,255,.06); border: 1px solid var(--line); margin-bottom: 18px; }
    .card h3 { font-size: 1.16rem; margin-bottom: 9px; }
    .card p { color: var(--mut); font-size: .93rem; }

    /* about split */
    .split { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; }
    .shot { border-radius: 24px; overflow: hidden; border: 1px solid var(--line); height: 400px; position: relative; }
    .shot::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(5,6,15,.85)); }
    .shot .cap { position: absolute; bottom: 20px; left: 22px; z-index: 2; font-family: 'JetBrains Mono'; font-size: .76rem; color: var(--c1); letter-spacing: 1.6px; }
    .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
    .chip { padding: 8px 16px; border: 1px solid var(--line); border-radius: 30px; font-size: .79rem; color: var(--mut); font-family: 'JetBrains Mono'; cursor: default; }
    .chip:hover { color: var(--c4); border-color: var(--c4); }

    /* gallery */
    .gal { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }
    .gal div { height: 210px; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); position: relative; }
    .gal div:nth-child(1), .gal div:nth-child(6) { grid-column: span 2; }
    .gal img { transition: .6s; object-fit: cover; }
    .gal div:hover img { transform: scale(1.09); }

    /* timeline */
    .tl { position: relative; padding-left: 34px; }
    .tl::before { content: ''; position: absolute; left: 8px; top: 6px; bottom: 6px; width: 2px; background: linear-gradient(var(--c1), var(--c2), var(--c3)); }
    .ev { position: relative; padding: 0 0 34px 14px; }
    .ev::before { content: ''; position: absolute; left: -33px; top: 6px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 3px solid var(--c1); box-shadow: 0 0 16px var(--c1); }
    .ev span { font-family: 'JetBrains Mono'; font-size: .74rem; color: var(--c4); letter-spacing: 1.6px; }
    .ev h4 { font-family: 'Syne'; font-size: 1.12rem; margin: 5px 0 5px; }
    .ev p { color: var(--mut); font-size: .92rem; }

    /* prizes */
    .prizes { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 22px; align-items: end; }
    .pz { text-align: center; padding: 38px 24px; border: 1px solid var(--line); border-radius: 24px; background: var(--card); }
    .pz.win { border-color: rgba(255,214,0,.55); background: linear-gradient(180deg, rgba(255,214,0,.12), rgba(255,255,255,.03)); transform: scale(1.05); }
    .pz .em { font-size: 2.4rem; }
    .pz b { display: block; font-family: 'Syne'; font-size: 1.85rem; margin: 10px 0 4px; }
    .pz small { color: var(--mut); font-family: 'JetBrains Mono'; font-size: .72rem; letter-spacing: 2px; }

    /* form */
    .formbox { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; padding: 44px; border: 1px solid var(--line); border-radius: 28px; background: var(--card); backdrop-filter: blur(10px); }
    .field { margin-bottom: 16px; }
    label { display: block; font-size: .75rem; letter-spacing: 1.6px; color: var(--mut); margin-bottom: 7px; font-family: 'JetBrains Mono'; }
    input, select, textarea { width: 100%; padding: 13px 16px; border-radius: 12px; background: rgba(255,255,255,.05); border: 1px solid var(--line); color: #fff; font-family: inherit; font-size: .94rem; outline: none; transition: .25s; }
    input:focus, select:focus, textarea:focus { border-color: var(--c1); background: rgba(0,229,255,.07); }
    select option { background: #0b0e1e; }
    .msg { margin-top: 14px; font-size: .88rem; color: var(--c4); display: none; }
    .rules { list-style: none; }
    .rules li { padding: 11px 0 11px 30px; border-bottom: 1px dashed var(--line); color: var(--mut); font-size: .92rem; position: relative; }
    .rules li::before { content: '▹'; position: absolute; left: 4px; color: var(--c1); }

    /* faq */
    .faq { border: 1px solid var(--line); border-radius: 16px; margin-bottom: 12px; overflow: hidden; background: var(--card); }
    .faq button { width: 100%; text-align: left; padding: 19px 24px; background: none; border: 0; color: #fff; font-family: 'Syne'; font-size: 1.02rem; cursor: pointer; display: flex; justify-content: space-between; gap: 14px; }
    .faq .ans { max-height: 0; overflow: hidden; transition: .4s; color: var(--mut); font-size: .93rem; padding: 0 24px; }
    .faq.open .ans { max-height: 230px; padding: 0 24px 20px; }
    .faq.open button i { transform: rotate(45deg); }
    .faq button i { font-style: normal; color: var(--c1); transition: .3s; }

    footer { padding: 60px 0 34px; border-top: 1px solid var(--line); background: rgba(0,0,0,.35); }
    .fgrid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; margin-bottom: 38px; }
    footer p, footer a { color: var(--mut); font-size: .9rem; }
    footer a:hover { color: var(--c1); }
    footer h5 { font-family: 'Syne'; font-size: 1rem; margin-bottom: 14px; color: #fff; }
    .fl { display: grid; gap: 9px; }
    .copy { text-align: center; padding-top: 24px; border-top: 1px solid var(--line); color: var(--mut); font-size: .8rem; font-family: 'JetBrains Mono'; }
    .rev { opacity: 0; transform: translateY(34px); transition: .8s cubic-bezier(.2,.7,.3,1); }
    .rev.in { opacity: 1; transform: none; }
    .marq { overflow: hidden; border-block: 1px solid var(--line); padding: 14px 0; background: rgba(255,255,255,.03); }
    .marq div { display: flex; gap: 44px; white-space: nowrap; animation: slide 22s linear infinite; font-family: 'Syne'; font-size: 1.05rem; color: var(--mut); }
    @keyframes slide { to { transform: translateX(-50%); } }

    /* ----- responsive ----- */
    @media (max-width: 900px) {
      .split, .formbox { grid-template-columns: 1fr; gap: 32px; }
      .gal { grid-template-columns: repeat(2,1fr); }
      .fgrid { grid-template-columns: 1fr 1fr; }
      nav { position: fixed; inset: 64px 4% auto; background: rgba(9,11,26,.97); border: 1px solid var(--line); border-radius: 20px; padding: 22px; display: none; backdrop-filter: blur(16px); }
      nav.show { display: block; }
      nav ul { flex-direction: column; gap: 16px; }
      .burger { display: flex; }
      .pz.win { transform: none; }
      .formbox { padding: 26px; }
      .hero-badge img { height: 36px; }
    }
  </style>
</head>
<body>
