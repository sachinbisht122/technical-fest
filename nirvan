<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NIRVAN '26 · GEHU Haldwani Tech Fest</title>
    <style>
        :root {
            /* Vibrant Mixed Colors */
            --bg: #0a0a1f; 
            --bg2: #131329;
            --card: rgba(255, 255, 255, 0.05); 
            --line: rgba(255, 255, 255, 0.1);
            --c1: #00e5ff; /* Neon Cyan */
            --c2: #ff2d95; /* Neon Pink */
            --c3: #7c4dff; /* Vibrant Purple */
            --c4: #ffd700; /* Gold */
            --txt: #ffffff; 
            --mut: #9aa3c7;
            --grad: linear-gradient(135deg, var(--c1), var(--c2) 50%, var(--c3));
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { 
            background-color: var(--bg); 
            background-image: radial-gradient(circle at 10% 20%, rgba(0, 229, 255, 0.1) 0%, transparent 40%), radial-gradient(circle at 80% 10%, rgba(255, 45, 149, 0.1) 0%, transparent 40%), radial-gradient(circle at 50% 100%, rgba(124, 77, 255, 0.15) 0%, transparent 50%);
            background-attachment: fixed;
            color: var(--txt); 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            line-height: 1.6; 
            overflow-x: hidden; 
        }
        
        /* Animated Background Particles */
        .glow { position: fixed; border-radius: 50%; filter: blur(120px); opacity: .4; z-index: -1; animation: float 10s infinite ease-in-out; }
        .g1 { width: 500px; height: 500px; background: var(--c2); top: -200px; left: -150px; }
        .g2 { width: 400px; height: 400px; background: var(--c1); top: 30%; right: -150px; animation-delay: 2s; }
        .g3 { width: 400px; height: 400px; background: var(--c3); bottom: -100px; left: 20%; animation-delay: 4s; }
        @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-30px); } }

        /* Header */
        header { position: fixed; top: 0; left: 0; right: 0; z-index: 99; padding: 15px 0; transition: .3s; }
        header.on { background: rgba(10, 10, 31, 0.9); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); padding: 10px 0; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
        .nav { width: min(1180px, 92%); margin: auto; display: flex; align-items: center; justify-content: space-between; }
        .logo { font-size: 1.6rem; font-weight: 900; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
        nav ul { display: flex; gap: 25px; list-style: none; }
        nav a { color: var(--mut); text-decoration: none; font-weight: 500; transition: .3s; position: relative; }
        nav a:hover { color: var(--c1); text-shadow: 0 0 10px var(--c1); }
        nav a::after { content: ''; position: absolute; left: 0; bottom: -5px; width: 0; height: 2px; background: var(--c2); transition: .3s; }
        nav a:hover::after { width: 100%; }

        /* Hero */
        .hero { min-height: 100vh; display: flex; align-items: center; padding: 120px 0; width: min(1180px, 92%); margin: auto; gap: 40px; }
        .hero-content { flex: 1; }
        .hero h1 { font-size: clamp(3.5rem, 10vw, 6.5rem); line-height: 1.1; font-weight: 900; animation: glitch 5s infinite; }
        .hero h1 .grad { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
        @keyframes glitch { 0%, 100% { transform: translate(0); } 20% { transform: translate(-2px, 2px); } 40% { transform: translate(2px, -2px); } 60% { transform: translate(-1px, -1px); } 80% { transform: translate(1px, 1px); } }
        .pill { display: inline-block; padding: 8px 16px; border: 1px solid var(--c1); border-radius: 30px; font-size: .85rem; color: var(--c1); background: rgba(0, 229, 255, 0.1); margin-bottom: 20px; font-weight: 600; box-shadow: 0 0 15px rgba(0, 229, 255, 0.3); }
        .subtitle { color: var(--mut); max-width: 650px; margin: 20px 0 30px; font-size: 1.2rem; }
        
        /* Buttons */
        .btn { display: inline-block; padding: 14px 32px; border-radius: 50px; font-weight: 700; font-size: .95rem; border: 0; cursor: pointer; transition: .3s; text-align: center; text-decoration: none; }
        .btn-p { background: var(--grad); color: #fff; box-shadow: 0 5px 20px rgba(255, 45, 149, 0.4); }
        .btn-p:hover { transform: translateY(-3px) scale(1.05); }
        .btn-o { border: 1px solid var(--c1); color: var(--c1); background: transparent; }
        .btn-o:hover { background: var(--c1); color: #fff; }

        .hero-btn { display:inline-block; padding:14px 35px; background: var(--grad); color: #fff; text-decoration:none; font-weight:bold; border-radius:50px; box-shadow: 0 5px 20px rgba(255, 45, 149, 0.4); transition: .3s; position: relative; overflow: hidden; }
        .hero-btn::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(120deg, transparent, rgba(255,255,255,0.3), transparent); transition: .5s; }
        .hero-btn:hover::before { left: 100%; }
        .hero-btn:hover { transform: translateY(-3px) scale(1.05); box-shadow: 0 8px 30px rgba(124, 77, 255, 0.6); }

        /* Sections */
        section { padding: 80px 0; width: min(1180px, 92%); margin: auto; }
        .head { margin-bottom: 40px; }
        .head .tag { color: var(--c2); font-weight: 600; letter-spacing: 2px; text-transform: uppercase; font-size: .85rem; text-shadow: 0 0 10px var(--c2); }
        .head h2 { font-size: clamp(2rem, 5vw, 3.5rem); margin-top: 10px; font-weight: 800; }
        .head p { color: var(--mut); max-width: 800px; margin-top: 15px; }

        /* Cards */
        .grid { display: grid; gap: 25px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 20px; transition: .4s cubic-bezier(0.175, 0.885, 0.32, 1.275); overflow: hidden; backdrop-filter: blur(10px); }
        .card:hover { transform: translateY(-10px) scale(1.02); border-color: var(--c1); box-shadow: 0 15px 40px rgba(0, 229, 255, 0.2); }
        .card-img { width: 100%; height: 180px; object-fit: cover; border-radius: 15px; margin-bottom: 15px; border: 1px solid var(--line); }
        .card .ico { font-size: 2.5rem; margin-bottom: 15px; animation: bounce 2s infinite; }
        @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
        .card h3 { font-size: 1.4rem; margin-bottom: 10px; }
        .card p { color: var(--mut); font-size: .95rem; margin-bottom: 20px; }

        /* Gallery */
        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px; }
        .gallery-item { height: 200px; border-radius: 15px; overflow: hidden; border: 1px solid var(--line); position: relative; }
        .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: .7s; }
        .gallery-item:hover img { transform: scale(1.2) rotate(2deg); }
        .gallery-item::after { content: ''; position: absolute; inset: 0; background: var(--grad); opacity: 0; transition: .4s; }
        .gallery-item:hover::after { opacity: 0.2; }

        /* Timeline */
        .timeline { position: relative; padding-left: 30px; }
        .timeline::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 3px; background: var(--grad); border-radius: 10px; box-shadow: 0 0 15px var(--c1); }
        .tl-item { position: relative; padding-bottom: 30px; }
        .tl-item::before { content: ''; position: absolute; left: -33px; top: 5px; width: 20px; height: 20px; border-radius: 50%; background: var(--bg); border: 4px solid var(--c1); box-shadow: 0 0 15px var(--c1); animation: pulse 2s infinite; }
        @keyframes pulse { 50% { box-shadow: 0 0 25px var(--c2); transform: scale(1.1); } }
        .tl-item b { display: block; font-size: 1.2rem; }
        .tl-item span { color: var(--c4); font-weight: 700; font-size: .9rem; }

        /* Footer */
        footer { background: rgba(0,0,0,0.3); border-top: 1px solid var(--line); padding: 50px 0; text-align: center; }
        .logo-footer { font-size: 1.5rem; font-weight: 900; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .query-box { background: var(--card); border: 1px solid var(--c1); border-radius: 20px; padding: 40px; display: inline-block; box-shadow: 0 0 30px rgba(0, 229, 255, 0.1); }
        .query-box h3 { color: var(--c1); margin-bottom: 15px; }
        .query-box a { color: var(--c4); font-size: 1.5rem; font-weight: bold; text-decoration: none; }

        /* Animations */
        .rev { opacity: 0; transform: translateY(50px); transition: 1s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
        .rev.in { opacity: 1; transform: none; }

        /* Chatbot */
        #chatbot-container { position: fixed; bottom: 25px; right: 25px; z-index: 9999; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        #chat-toggle { width: 60px; height: 60px; border-radius: 50%; background: var(--grad); border: none; cursor: pointer; box-shadow: 0 10px 30px rgba(255, 45, 149, 0.5); font-size: 30px; color: #fff; transition: .3s; display: flex; align-items: center; justify-content: center; animation: pulse 2s infinite; }
        #chat-toggle:hover { transform: scale(1.15) rotate(10deg); }
        #chat-window { position: absolute; bottom: 75px; right: 0; width: 350px; height: 500px; background: #131329; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); display: none; flex-direction: column; overflow: hidden; border: 1px solid var(--line); }
        #chat-window.active { display: flex; animation: slideUp .3s ease; }
        @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        #chat-header { background: var(--grad); color: #fff; padding: 15px; display: flex; align-items: center; gap: 10px; font-weight: 700; }
        #chat-header i { font-size: 20px; }
        #chat-close { margin-left: auto; background: transparent; border: none; color: #fff; font-size: 20px; cursor: pointer; }
        #chat-body { flex: 1; padding: 15px; overflow-y: auto; background: rgba(255,255,255,0.02); }
        #chat-input-area { padding: 10px; border-top: 1px solid var(--line); background: rgba(0,0,0,0.3); display: flex; gap: 10px; }
        #chat-input { flex: 1; padding: 10px; border: 1px solid var(--line); border-radius: 20px; outline: none; background: rgba(255,255,255,0.05); color: #fff; }
        #chat-send { width: 40px; height: 40px; border-radius: 50%; background: var(--c1); color: #fff; border: none; cursor: pointer; }
        .msg { margin-bottom: 12px; display: flex; }
        .msg-bot { justify-content: flex-start; }
        .msg-user { justify-content: flex-end; }
        .bubble { padding: 10px 15px; border-radius: 16px; max-width: 80%; font-size: 0.9rem; line-height: 1.4; animation: msgIn .3s ease; }
        @keyframes msgIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .msg-bot .bubble { background: rgba(255,255,255,0.1); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
        .msg-user .bubble { background: var(--grad); color: #fff; border-bottom-right-radius: 4px; }
        .typing-indicator span { display: inline-block; width: 8px; height: 8px; background: var(--mut); border-radius: 50%; margin-right: 4px; animation: blink 1.4s infinite both; }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes blink { 0%, 80%, 100% { opacity: 0; } 40% { opacity: 1; } }

        /* Ticket Style */
        .ticket-canvas { min-height: 100%; display: flex; align-items: center; justify-content: center; padding: 2em; flex: 1; }
        .ticket-wrapper { --t-bg: #1a1a2e; --t-bg-light: #232345; --t-accent: #ff2d95; --t-accent-glow: rgba(255, 45, 149, 0.5); --t-text-main: #f8fafc; --t-text-muted: #94a3b8; font-size: 10px; perspective: 1000px; display: inline-block; }
        .ticket { position: relative; width: 22em; color: var(--t-text-main); font-family: "Space Grotesk", "Segoe UI", system-ui, sans-serif; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s ease; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05); background: transparent; filter: drop-shadow(0px 0px 10px rgba(0, 0, 0, 0.5)); }
        .ticket-wrapper:hover .ticket { transform: rotateX(5deg) rotateY(-10deg) scale(1.02); box-shadow: 20px 20px 40px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.1), -5px -5px 20px var(--t-accent-glow); }
        .t-main { padding: 2em; position: relative; overflow: hidden; background: radial-gradient(circle at bottom left, transparent 1em, var(--t-bg) 1.05em), radial-gradient(circle at bottom right, transparent 1em, var(--t-bg) 1.05em); background-size: 51% 100%; background-position: bottom left, bottom right; background-repeat: no-repeat; border-top-left-radius: 1em; border-top-right-radius: 1em; }
        .t-content { position: relative; z-index: 1; }
        .t-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2em; }
        .t-logo { display: flex; align-items: center; gap: 0.5em; font-weight: 900; font-size: 1.2em; letter-spacing: -0.05em; color: #fff; }
        .t-type { font-size: 0.6em; text-transform: uppercase; letter-spacing: 0.2em; color: var(--t-accent); border: 1px solid var(--t-accent); padding: 0.4em 0.8em; border-radius: 99em; font-weight: 700; }
        .t-title { font-size: 2.5em; font-weight: 900; line-height: 1.1; margin-bottom: 0.2em; text-transform: uppercase; background: linear-gradient(135deg, #00e5ff 0%, #ff2d95 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .t-subtitle { color: var(--t-text-muted); font-size: 0.9em; margin-bottom: 2.5em; }
        .t-details { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5em; margin-bottom: 1em; }
        .t-label { font-size: 0.6em; text-transform: uppercase; letter-spacing: 0.1em; color: var(--t-text-muted); }
        .t-value { font-size: 1.1em; font-weight: 700; color: var(--t-text-main); }
        .t-perforation { display: flex; justify-content: space-between; height: 1em; align-items: center; position: relative; z-index: 2; }
        .t-perf-line { flex-grow: 1; height: 0; border-top: 2px dashed rgba(255, 255, 255, 0.2); margin: 0 1.5em; }
        .t-stub { padding: 2em; background: radial-gradient(circle at top left, transparent 1em, var(--t-bg-light) 1.05em), radial-gradient(circle at top right, transparent 1em, var(--t-bg-light) 1.05em); background-size: 51% 100%; background-position: top left, top right; background-repeat: no-repeat; border-bottom-left-radius: 1em; border-bottom-right-radius: 1em; display: flex; justify-content: space-between; align-items: center; position: relative; }
        .t-barcode { width: 10em; height: 3em; background: repeating-linear-gradient(90deg, #fff 0, #fff 2px, transparent 2px, transparent 4px, #fff 4px, #fff 5px, transparent 5px, transparent 8px, #fff 8px, #fff 12px, transparent 12px, transparent 15px, #fff 15px, #fff 16px, transparent 16px, transparent 18px); opacity: 0.8; }
        .t-admit { text-align: right; }
        .t-admit-num { font-size: 3em; font-weight: 900; line-height: 1; color: var(--t-accent); text-shadow: 0 0 15px var(--t-accent-glow); }
    </style>
</head>
