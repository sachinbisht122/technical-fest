        </div>
    </footer>

    <!-- AI Chatbot -->
    <div id="chatbot-container">
        <div id="chat-window">
            <div id="chat-header">
                <i class="fa-solid fa-robot"></i> NIRVAN AI Assistant
                <button id="chat-close">×</button>
            </div>
            <div id="chat-body">
                <div class="msg msg-bot"><div class="bubble">Hello! 👋 I am the NIRVAN '26 AI. Ask me anything about registration, events, fees, or food!</div></div>
            </div>
            <div id="chat-input-area">
                <input type="text" id="chat-input" placeholder="Type your question...">
                <button id="chat-send"><i class="fa-solid fa-paper-plane"></i></button>
            </div>
        </div>
        <button id="chat-toggle"><i class="fa-solid fa-comment-dots"></i></button>
    </div>

    <script>
        const hd = document.getElementById('hd');
        window.addEventListener('scroll', () => hd.classList.toggle('on', window.scrollY > 60));

        const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && e.target.classList.add('in')), { threshold: .15 });
        document.querySelectorAll('.rev').forEach(el => io.observe(el));

        const chatToggle = document.getElementById('chat-toggle');
        const chatWindow = document.getElementById('chat-window');
        const chatClose = document.getElementById('chat-close');
        const chatInput = document.getElementById('chat-input');
        const chatSend = document.getElementById('chat-send');
        const chatBody = document.getElementById('chat-body');

        chatToggle.addEventListener('click', () => chatWindow.classList.toggle('active'));
        chatClose.addEventListener('click', () => chatWindow.classList.remove('active'));
        chatSend.addEventListener('click', handleUserMessage);
        chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleUserMessage(); });

        const knowledgeBase = [
            { keywords: ['fee', 'price', 'cost', 'money'], answer: "The Hackathon registration fee is ₹150 per member. The CTF event has a separate fee of ₹50 per team. Webathon and Tech Quiz are free for GEHU students!" },
            { keywords: ['food', 'eat', 'meal', 'snack', 'dinner'], answer: "Yes! Meals, refreshments, dinner, and midnight snacks are provided to all registered participants during the 24-hour Hackathon." },
            { keywords: ['team', 'teamsize', 'members', 'group'], answer: "For Hackathon and Webathon, teams consist of 2 to 4 members. CTF allows teams of 2 to 3 members (or solo). Cross-branch teams are allowed!" },
            { keywords: ['laptop', 'bring', 'computer'], answer: "Please bring your own laptop, charger, and extension board. A valid college ID is mandatory for entry." },
            { keywords: ['date', 'when', 'timing', 'time', 'schedule'], answer: "Registrations close on August 25, 2026. The Hackathon begins on September 3rd at 11:00 AM and ends September 4th at 11:00 AM." },
            { keywords: ['where', 'location', 'venue', 'place'], answer: "All events are held at the Main Auditorium and Computer Labs at Graphic Era Hill University, Haldwani Campus." },
            { keywords: ['hackathon', 'event'], answer: "The Hackathon is our flagship 24-hour event! Teams solve 5-7 real-world problem statements. The total prize pool is ₹30,000! 🏆" },
            { keywords: ['ctf', 'cyber', 'security'], answer: "CTF (Capture The Flag) is a cybersecurity puzzle hunt covering cryptography, reverse engineering, and web exploitation. It takes place on August 25th from 11 AM to 3 PM." },
            { keywords: ['webathon', 'web'], answer: "Webathon is a web design and development competition. Build a responsive website in 24 hours! Track choices include UI/UX, Frontend, and Full-Stack." },
            { keywords: ['quiz', 'tech quiz'], answer: "The Tech Quiz is a rapid-fire event testing your knowledge on AI, programming, and emerging technologies. Winners get medals and certificates!" },
            { keywords: ['register', 'signup', 'join'], answer: "To register, look for the 'Register' button or click on the 'Explore Events' button in the top section of this page!" },
            { keywords: ['hello', 'hi', 'hey'], answer: "Hello! 😊 How can I help you with NIRVAN '26 today? You can ask about fees, dates, or specific events!" }
        ];

        function handleUserMessage() {
            const text = chatInput.value.trim();
            if (!text) return;
            addMessage(text, 'user');
            chatInput.value = '';
            showTyping();
            setTimeout(() => {
                let found = false;
                for (const entry of knowledgeBase) {
                    if (entry.keywords.some(k => text.toLowerCase().includes(k))) {
                        addMessage(entry.answer, 'bot');
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    addMessage("I'm sorry, I don't have an answer to that specifically. Please contact the Tech Geeks Club at +91 98765 43210 for more details!", 'bot');
                }
            }, 1000);
        }

        function addMessage(text, sender) {
            const msgDiv = document.createElement('div');
            msgDiv.className = `msg msg-${sender}`;
            msgDiv.innerHTML = `<div class="bubble">${text}</div>`;
            chatBody.appendChild(msgDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        function showTyping() {
            const typingDiv = document.createElement('div');
            typingDiv.className = 'msg msg-bot';
            typingDiv.innerHTML = `<div class="bubble typing-indicator"><span></span><span></span><span></span></div>`;
            chatBody.appendChild(typingDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
            setTimeout(() => typingDiv.remove(), 1000);
        }
    </script>
</body>
</html>
